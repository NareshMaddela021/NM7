# Copy to .env and fill in. Never commit the real file.
APP_ENV=dev
# MongoDB: Atlas gives mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
# Local: a one-node replica set (see README). Transactions need a replica set.
MONGODB_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0
MONGODB_DB=nm7
SECRET_KEY=change-me-to-a-long-random-string
# Encrypts admin authenticator secrets (falls back to SECRET_KEY). Never change it once admins exist.
ENCRYPTION_KEY=
CORS_ORIGINS=http://localhost:5173
# Optional full-match regex for extra origins, e.g. Vercel previews: ^https://nm7-[a-z0-9-]+-<team-slug>\.vercel\.app$
CORS_ORIGIN_REGEX=
COOKIE_DOMAIN=
# lax = site and API on the same domain (nm7.si); none = different sites, e.g. testing on *.onrender.com
COOKIE_SAMESITE=lax

# Email: resend (default) or zeptomail. Without a key, dev prints emails (with codes) to the log; production
# answers 503 "Email is temporarily unavailable" on sign-up / resend code / forgot password.
EMAIL_PROVIDER=resend
EMAIL_FROM=Nm7 <no-reply@nm7.si>
EMAIL_REPLY_TO=info@nm7.si
RESEND_API_KEY=
# Only for EMAIL_PROVIDER=zeptomail:
ZEPTOMAIL_TOKEN=

# One-time owner setup at /admin/setup (24+ chars). Only works while no admin exists; delete after use.
ADMIN_SETUP_TOKEN=

# Snap photos (reading resumes from photos with the Claude API). Empty = the feature answers "being switched on".
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Razorpay — empty until keys exist (tests mock Razorpay)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
