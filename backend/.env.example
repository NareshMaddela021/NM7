# Copy to .env and fill in. Never commit the real file.
APP_ENV=dev
DATABASE_URL=postgresql+asyncpg://nm7:nm7@localhost:5432/nm7
SECRET_KEY=change-me-to-a-long-random-string
# Encrypts admin authenticator secrets (falls back to SECRET_KEY). Never change it once admins exist.
ENCRYPTION_KEY=
CORS_ORIGINS=http://localhost:5173
# Optional full-match regex for extra origins, e.g. Vercel previews: ^https://nm7-[a-z0-9-]+-<team-slug>\.vercel\.app$
CORS_ORIGIN_REGEX=
COOKIE_DOMAIN=
# lax = site and API on the same domain (nm7.si); none = different sites, e.g. testing on *.onrender.com
COOKIE_SAMESITE=lax

# Email (Zoho ZeptoMail). Empty token in dev = emails (with codes) are printed to the log.
ZEPTOMAIL_TOKEN=
ZEPTOMAIL_URL=https://api.zeptomail.in/v1.1/email
EMAIL_FROM=noreply@nm7.si

# Razorpay — empty until keys exist (tests mock Razorpay)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
