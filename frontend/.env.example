# Copy to .env.local and fill in. Never commit the real file.
# With VITE_API_BASE set, sign-in, checkout (Razorpay) and refunds use the backend.
# Leave it empty (or delete the file) to run the preview on sample data.
VITE_API_BASE=https://api.nm7.si
# The Razorpay key id comes from the backend with each order; nothing else is needed here.
# Blog: Hygraph's public Content API (read-only, published posts only — not a secret). Optional: this is the default.
VITE_HYGRAPH_ENDPOINT=https://ap-south-1.cdn.hygraph.com/content/cmup9f6ob0ktu06w8zze56jn9/master
